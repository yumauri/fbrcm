# README hero: approximately 100x32 terminal cells.
Output vhs/demo.gif

Require go
Require python3
Require ttyd
Require ffmpeg

Set Shell zsh
Set Width 1200
Set Height 720
Set FontSize 18
Set FontFamily "Cascadia Code"
Set LineHeight 1.0
Set LetterSpacing 0
Set TypingSpeed 80 ms
Set Theme "Catppuccin Frappe"
Set Padding 0
Set Margin 0
Set BorderRadius 0
Set Framerate 24
Set CursorBlink false

Env FBRCM_VHS_THEME "default"

Source vhs/website-scenario.tape
