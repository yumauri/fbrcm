{
  "$defs": {
    "path_segment": {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/path_segment"
    },
    "physical_project_selector": {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/physical_project_selector"
    }
  },
  "$id": "urn:fbrcm:schema:cli:1.0.0:command:project.templates.set:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "options": {
          "anyOf": [
            {
              "required": [
                "templates"
              ]
            },
            {
              "required": [
                "primary"
              ]
            }
          ]
        }
      }
    },
    {
      "properties": {
        "options": {
          "if": {
            "properties": {
              "primary": {
                "pattern": "^(?:[cC][lL][iI][eE][nN][tT])$"
              }
            },
            "required": [
              "primary",
              "templates"
            ]
          },
          "then": {
            "properties": {
              "templates": {
                "contains": {
                  "pattern": "^(?:[cC][lL][iI][eE][nN][tT])$"
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "options": {
          "if": {
            "properties": {
              "primary": {
                "pattern": "^(?:[sS][eE][rR][vV][eE][rR])$"
              }
            },
            "required": [
              "primary",
              "templates"
            ]
          },
          "then": {
            "properties": {
              "templates": {
                "contains": {
                  "pattern": "^(?:[sS][eE][rR][vV][eE][rR])$"
                }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "arguments": {
      "additionalProperties": false,
      "properties": {
        "project": {
          "$ref": "#/$defs/physical_project_selector"
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "no-local-config": {
          "description": "Ignore .fbrcm.toml repository configuration (env: FBRCM_NO_LOCAL_CONFIG)",
          "type": "boolean"
        },
        "primary": {
          "description": "Set the primary template: client or server",
          "pattern": "^(?:[cC][lL][iI][eE][nN][tT]|[sS][eE][rR][vV][eE][rR])$",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            },
            {
              "operator": "lowercase",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ],
          "x-fbrcm-values": [
            "client",
            "server"
          ]
        },
        "profile": {
          "allOf": [
            {
              "$ref": "#/$defs/path_segment"
            }
          ],
          "description": "Use profile for this invocation without changing the active profile (env: FBRCM_PROFILE)",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ]
        },
        "templates": {
          "description": "Replace enabled templates with client, server, or both",
          "items": {
            "pattern": "^(?:[cC][lL][iI][eE][nN][tT]|[sS][eE][rR][vV][eE][rR])$",
            "type": "string",
            "x-fbrcm-normalization": [
              {
                "operator": "trim_unicode_whitespace",
                "source": "argv",
                "target": "normalized_invocation"
              },
              {
                "operator": "lowercase",
                "source": "argv",
                "target": "normalized_invocation"
              }
            ],
            "x-fbrcm-values": [
              "client",
              "server"
            ]
          },
          "minItems": 1,
          "type": "array",
          "x-fbrcm-normalization": [
            {
              "operator": "deduplicate_preserve_first",
              "source": "argv",
              "target": "normalized_invocation"
            },
            {
              "operator": "sort_by_declared_order",
              "order": [
                "client",
                "server"
              ],
              "source": "argv",
              "target": "normalized_invocation"
            }
          ]
        },
        "timeout": {
          "description": "Maximum duration for the complete command",
          "not": {
            "pattern": "^\\+?(?:0*\\.)\\d+ns$"
          },
          "pattern": "^\\+?(?:(?:0+(?:\\.0*)?|\\.0+)(?:ns|us|µs|μs|ms|s|m|h))*(?:(?:\\d*[1-9]\\d*(?:\\.\\d*)?|0*\\.\\d*[1-9]\\d*)(?:ns|us|µs|μs|ms|s|m|h))(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h))*$",
          "type": "string",
          "x-fbrcm-grammar": "go-duration",
          "x-fbrcm-validation": [
            {
              "operator": "parse_duration",
              "parser": "time.ParseDuration",
              "require_positive": true
            }
          ]
        }
      },
      "required": [],
      "type": "object"
    },
    "stdin": {
      "type": "null"
    }
  },
  "required": [
    "arguments",
    "options",
    "stdin"
  ],
  "type": "object"
}
