{
  "$defs": {
    "path_segment": {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/path_segment"
    }
  },
  "$id": "urn:fbrcm:schema:cli:1.0.0:command:root:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "options": {
            "properties": {
              "version": {
                "const": false
              }
            },
            "required": [
              "profile"
            ]
          }
        },
        "required": [
          "options"
        ]
      },
      "then": {
        "properties": {
          "options": {
            "properties": {
              "profile": {
                "allOf": [
                  {
                    "$ref": "#/$defs/path_segment"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "arguments": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "no-local-config": {
          "description": "Ignore .fbrcm.toml repository configuration (env: FBRCM_NO_LOCAL_CONFIG); accepted but not applied with --version",
          "type": "boolean",
          "x-fbrcm-effective-when": [
            {
              "all_of": [
                {
                  "source": "option",
                  "name": "version",
                  "operator": "equals",
                  "value": false
                }
              ]
            }
          ]
        },
        "profile": {
          "description": "Use profile for this invocation without changing the active profile (env: FBRCM_PROFILE); accepted but not applied with --version",
          "pattern": ".*\\S.*",
          "type": "string",
          "x-fbrcm-effective-when": [
            {
              "all_of": [
                {
                  "source": "option",
                  "name": "version",
                  "operator": "equals",
                  "value": false
                }
              ]
            }
          ],
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ]
        },
        "stateless": {
          "const": false,
          "description": "Run a supported command without profiles or application-managed local state (Firebase API token env: FBRCM_GOOGLE_ACCESS_TOKEN); true is currently rejected by this command",
          "type": "boolean"
        },
        "timeout": {
          "description": "Maximum duration for the complete command",
          "not": {
            "pattern": "^\\+?(?:0*\\.)\\d+ns$"
          },
          "pattern": "^\\+?(?:(?:0+(?:\\.0*)?|\\.0+)(?:ns|us|µs|μs|ms|s|m|h))*(?:(?:\\d*[1-9]\\d*(?:\\.\\d*)?|0*\\.\\d*[1-9]\\d*)(?:ns|us|µs|μs|ms|s|m|h))(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h))*$",
          "type": "string",
          "x-fbrcm-grammar": "go-duration",
          "x-fbrcm-validation": [
            {
              "operator": "parse_duration",
              "parser": "time.ParseDuration",
              "require_positive": true
            }
          ]
        },
        "version": {
          "description": "Print build version",
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "stdin": {
      "type": "null"
    }
  },
  "required": [
    "arguments",
    "options",
    "stdin"
  ],
  "type": "object"
}
