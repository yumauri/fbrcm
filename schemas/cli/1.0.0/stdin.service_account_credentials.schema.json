{
  "$id": "urn:fbrcm:schema:cli:1.0.0:stdin:service_account_credentials",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Google service-account credential JSON",
  "properties": {
    "client_email": {
      "type": "string",
      "x-fbrcm-validation": [
        {
          "operator": "parse_email",
          "parser": "net/mail.ParseAddress",
          "require_exact": true
        }
      ]
    },
    "private_key": {
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "project_id": {
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "token_uri": {
      "type": "string",
      "x-fbrcm-validation": [
        {
          "normalization": "trim_unicode_whitespace",
          "operator": "parse_uri",
          "parser": "net/url.ParseRequestURI",
          "require_absolute": true
        }
      ]
    },
    "type": {
      "const": "service_account"
    }
  },
  "required": [
    "type",
    "project_id",
    "private_key",
    "client_email",
    "token_uri"
  ],
  "type": "object"
}
