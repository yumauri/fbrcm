                    "type": "object"
                  }
                },
                "required": [
                  "id",
                  "path",
                  "summary",
                  "invocation_schema",
                  "response_schema",
                  "side_effect_level",
                  "destructive",
                  "supports"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "contract_version": {
              "const": "1.0.0"
            },
            "count": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "contract_version",
            "count",
            "commands"
          ],
          "type": "object",
          "x-fbrcm-invariants": [
            {
              "left": {
                "field": "count"
              },
              "op": "eq",
              "right": {
                "op": "length",
                "value": {
                  "field": "commands"
                }
              }
