  "$id": "urn:fbrcm:schema:cli:1.0.0:command:root:response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:envelope"
