                  "destructive": {
                    "type": "boolean"
                  },
                  "id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "invocation_schema": {
                    "pattern": "^urn:fbrcm:schema:cli:",
                    "type": "string"
                  },
                  "path": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "response_schema": {
                    "pattern": "^urn:fbrcm:schema:cli:",
                    "type": "string"
                  },
                  "side_effect_level": {
