{
  "$defs": {
    "physical_project_id": {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/physical_project_id"
    },
    "project_alias": {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/project_alias"
    }
  },
  "$id": "urn:fbrcm:schema:cli:1.0.0:command:projects.aliases.set:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "$ref": "#/$defs/project_alias"
        },
        "project_id": {
          "$ref": "#/$defs/physical_project_id"
        }
      },
      "required": [
        "alias",
        "project_id"
      ],
      "type": "object"
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "no-local-config": {
          "description": "Ignore .fbrcm.toml repository configuration (env: FBRCM_NO_LOCAL_CONFIG)",
          "type": "boolean"
        },
        "profile": {
          "description": "Use profile for this invocation without changing the active profile (env: FBRCM_PROFILE); accepted but not applied by this command",
          "pattern": ".*\\S.*",
          "type": "string",
          "x-fbrcm-effective": false
        },
        "stateless": {
          "const": false,
          "description": "Run a supported command without profiles or application-managed local state (Firebase API token env: FBRCM_GOOGLE_ACCESS_TOKEN); true is currently rejected by this command",
          "type": "boolean"
        },
        "timeout": {
          "description": "Maximum duration for the complete command",
          "not": {
            "pattern": "^\\+?(?:0*\\.)\\d+ns$"
          },
          "pattern": "^\\+?(?:(?:0+(?:\\.0*)?|\\.0+)(?:ns|us|µs|μs|ms|s|m|h))*(?:(?:\\d*[1-9]\\d*(?:\\.\\d*)?|0*\\.\\d*[1-9]\\d*)(?:ns|us|µs|μs|ms|s|m|h))(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h))*$",
          "type": "string",
          "x-fbrcm-grammar": "go-duration",
          "x-fbrcm-validation": [
            {
              "operator": "parse_duration",
              "parser": "time.ParseDuration",
              "require_positive": true
            }
          ]
        },
        "yes": {
          "description": "Replace an existing alias without confirmation",
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "stdin": {
      "type": "null"
    }
  },
  "required": [
    "arguments",
    "options",
    "stdin"
  ],
  "type": "object"
}
