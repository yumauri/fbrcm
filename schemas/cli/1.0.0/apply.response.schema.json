{
  "$defs": {
    "success_data": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "items": {
                "items": {
                  "properties": {
                    "status": {
                      "enum": [
                        "unchanged",
                        "published",
                        "already-applied",
                        "conflict",
                        "publish-failed",
                        "published-hook-failed",
                        "published-cache-failed"
                      ]
                    }
                  }
                }
              }
            }
          },
          "if": {
            "properties": {
              "dry_run": {
                "const": true
              }
            },
            "required": [
              "dry_run"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "properties": {
                    "status": {
                      "enum": [
                        "unchanged",
                        "would-publish",
                        "already-applied"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "items": {
          "items": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "unchanged"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "allOf": [
                    {
                      "not": {
                        "required": [
                          "published_version"
                        ]
                      }
                    }
                  ],
                  "properties": {
                    "error": {
                      "type": "null"
                    },
                    "validated": {
                      "const": true
                    },
                    "validation_source": {
                      "const": "local"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "would-publish"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "allOf": [
                    {
                      "not": {
                        "required": [
                          "published_version"
                        ]
                      }
                    }
                  ],
                  "properties": {
                    "error": {
                      "type": "null"
                    },
                    "validated": {
                      "const": true
                    },
                    "validation_source": {
                      "const": "firebase"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "published"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "error": {
                      "type": "null"
                    },
                    "published_version": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "validated": {
                      "const": true
                    },
                    "validation_source": {
                      "const": "firebase"
                    }
                  },
                  "required": [
                    "published_version"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "already-applied"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "allOf": [
                    {
                      "not": {
                        "required": [
                          "published_version"
                        ]
                      }
                    }
                  ],
                  "properties": {
                    "error": {
                      "type": "null"
                    },
                    "validated": {
                      "const": true
                    },
                    "validation_source": {
                      "const": "local"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "conflict"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "allOf": [
                    {
                      "not": {
                        "required": [
                          "published_version"
                        ]
                      }
                    }
                  ],
                  "properties": {
                    "error": {
                      "properties": {
                        "stage": {
                          "const": "publication"
                        }
                      },
                      "required": [
                        "stage"
                      ],
                      "type": "object"
                    },
                    "validated": {
                      "const": true
                    },
                    "validation_source": {
                      "const": "firebase"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "publish-failed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "allOf": [
                    {
                      "not": {
                        "required": [
                          "published_version"
                        ]
                      }
                    }
                  ],
                  "properties": {
                    "error": {
                      "properties": {
                        "stage": {
                          "const": "publication"
                        }
                      },
                      "required": [
                        "stage"
                      ],
                      "type": "object"
                    },
                    "validated": {
                      "const": true
                    },
                    "validation_source": {
                      "const": "firebase"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "published-hook-failed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "error": {
                      "properties": {
                        "stage": {
                          "const": "post_publish_hook"
                        }
                      },
                      "required": [
                        "stage"
                      ],
                      "type": "object"
                    },
                    "published_version": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "validated": {
                      "const": true
                    },
                    "validation_source": {
                      "const": "firebase"
                    }
                  },
                  "required": [
                    "published_version",
                    "error"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "published-cache-failed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "error": {
                      "properties": {
                        "stage": {
                          "const": "cache"
                        }
                      },
                      "required": [
                        "stage"
                      ],
                      "type": "object"
                    },
                    "published_version": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "validated": {
                      "const": true
                    },
                    "validation_source": {
                      "const": "firebase"
                    }
                  },
                  "required": [
                    "published_version",
                    "error"
                  ]
                }
              }
            ],
            "properties": {
              "error": {
                "additionalProperties": false,
                "properties": {
                  "message": {
                    "maxLength": 4097,
                    "type": "string",
                    "x-fbrcm-safe-text": "at most 4096 Unicode code points, followed by one ellipsis when truncated"
                  },
                  "stage": {
                    "enum": [
                      "publication",
                      "post_publish_hook",
                      "cache"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "message",
                  "stage"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "previous_version": {
                "type": "string"
              },
              "published_version": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "unchanged",
                  "would-publish",
                  "published",
                  "already-applied",
                  "conflict",
                  "publish-failed",
                  "published-hook-failed",
                  "published-cache-failed"
                ],
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "validated": {
                "type": "boolean"
              },
              "validation_source": {
                "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/validation_source",
                "enum": [
                  "local",
                  "firebase"
                ]
              }
            },
            "required": [
              "status",
              "target",
              "validated",
              "validation_source"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "plan_id": {
          "type": "string"
        },
        "published_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dry_run",
        "items",
        "plan_id",
        "published_count"
      ],
      "type": "object",
      "x-fbrcm-invariants": [
        {
          "left": {
            "field": "published_count"
          },
          "op": "eq",
          "right": {
            "collection": {
              "field": "items"
            },
            "op": "count_where",
            "where": {
              "op": "in",
              "set": [
                "published",
                "published-hook-failed",
                "published-cache-failed"
              ],
              "value": {
                "field": "item.status"
              }
            }
          }
        }
      ]
    }
  },
  "$id": "urn:fbrcm:schema:cli:1.0.0:command:apply:response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:envelope"
    },
    {
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "success",
                  "partial_success"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/success_data"
              }
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "enum": [
                "success",
                "partial_success",
                "failure"
              ]
            }
          }
        },
        {
          "properties": {
            "warnings": {
              "items": {
                "properties": {
                  "code": {
                    "enum": [
                      "plan.source_draft_changed",
                      "publication.cache_stale",
                      "publication.draft_cleanup_failed",
                      "publication.non_atomic",
                      "publication.post_publish_hook_failed"
                    ]
                  }
                },
                "required": [
                  "code"
                ]
              },
              "type": "array"
            }
          }
        },
        {
          "properties": {
            "errors": {
              "items": {
                "properties": {
                  "code": {
                    "enum": [
                      "argument.invalid",
                      "auth.configuration_invalid",
                      "auth.credentials_invalid",
                      "auth.not_found",
                      "auth.quota_project_required",
                      "auth.setup_required",
                      "batch.failed",
                      "batch.partial_success",
                      "command.canceled",
                      "command.timeout",
                      "configuration.invalid",
                      "file.io_failed",
                      "filesystem.permission_denied",
                      "firebase.permission_denied",
                      "firebase.rate_limited",
                      "firebase.request_failed",
                      "firebase.service_unavailable",
                      "firebase.timeout",
                      "hook.failed",
                      "interaction.required",
                      "internal.contract_violation",
                      "internal.unclassified",
                      "network.offline",
                      "network.timeout",
                      "network.unavailable",
                      "plan.integrity_failed",
                      "plan.invalid",
                      "plan.stale",
                      "plan.unsupported_version",
                      "profile.invalid",
                      "publication.cache_failed",
                      "publication.hook_failed",
                      "remote_config.conflict",
                      "remote_config.invalid",
                      "remote_config.validation_failed",
                      "resource.not_found"
                    ]
                  }
                },
                "required": [
                  "code"
                ]
              },
              "type": "array"
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "success"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "enum": [
                  0
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "failure"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "not": {
                  "const": 1
                }
              }
            }
          }
        }
      ],
      "properties": {
        "command": {
          "const": "apply"
        },
        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/success_data"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema": {
          "const": "urn:fbrcm:schema:cli:1.0.0:command:apply:response"
        }
      },
      "required": [
        "schema",
        "command",
        "data"
      ],
      "type": "object"
    }
  ]
}
