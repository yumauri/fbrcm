{
  "$defs": {
    "success_data": {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "error": {
                "additionalProperties": false,
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "stage": {
                    "type": "string"
                  }
                },
                "required": [
                  "message",
                  "stage"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "previous_version": {
                "type": "string"
              },
              "published_version": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "unchanged",
                  "would-publish",
                  "published",
                  "already-applied",
                  "conflict",
                  "publish-failed",
                  "published-hook-failed",
                  "published-cache-failed"
                ],
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "validated": {
                "type": "boolean"
              },
              "validation_source": {
                "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/validation_source",
                "enum": [
                  "local",
                  "firebase"
                ]
              }
            },
            "required": [
              "status",
              "target",
              "validated",
              "validation_source"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "plan_id": {
          "type": "string"
        },
        "published_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dry_run",
        "items",
        "plan_id",
        "published_count"
      ],
      "type": "object"
    }
  },
  "$id": "urn:fbrcm:schema:cli:1.0.0:command:apply:response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:envelope"
    },
    {
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "success",
                  "partial_success"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/success_data"
              }
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "enum": [
                "success",
                "partial_success",
                "failure"
              ]
            }
          }
        },
        {
          "properties": {
            "warnings": {
              "items": {
                "properties": {
                  "code": {
                    "enum": [
                      "plan.source_draft_changed",
                      "publication.cache_stale",
                      "publication.draft_cleanup_failed",
                      "publication.non_atomic",
                      "publication.post_publish_hook_failed"
                    ]
                  }
                },
                "required": [
                  "code"
                ]
              },
              "type": "array"
            }
          }
        },
        {
          "properties": {
            "errors": {
              "items": {
                "properties": {
                  "code": {
                    "enum": [
                      "argument.invalid",
                      "auth.configuration_invalid",
                      "auth.credentials_invalid",
                      "auth.not_found",
                      "auth.quota_project_required",
                      "auth.setup_required",
                      "batch.failed",
                      "batch.partial_success",
                      "command.canceled",
                      "command.timeout",
                      "configuration.invalid",
                      "draft.exists",
                      "file.io_failed",
                      "filesystem.permission_denied",
                      "firebase.permission_denied",
                      "firebase.rate_limited",
                      "firebase.request_failed",
                      "firebase.service_unavailable",
                      "firebase.timeout",
                      "hook.failed",
                      "interaction.required",
                      "internal.contract_violation",
                      "internal.unclassified",
                      "network.offline",
                      "network.timeout",
                      "network.unavailable",
                      "plan.integrity_failed",
                      "plan.invalid",
                      "plan.stale",
                      "plan.unsupported_version",
                      "profile.invalid",
                      "publication.cache_failed",
                      "publication.hook_failed",
                      "remote_config.conflict",
                      "remote_config.invalid",
                      "remote_config.validation_failed",
                      "resource.not_found"
                    ]
                  }
                },
                "required": [
                  "code"
                ]
              },
              "type": "array"
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "success"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "enum": [
                  0
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "failure"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "not": {
                  "const": 1
                }
              }
            }
          }
        }
      ],
      "properties": {
        "command": {
          "const": "apply"
        },
        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/success_data"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema": {
          "const": "urn:fbrcm:schema:cli:1.0.0:command:apply:response"
        }
      },
      "required": [
        "schema",
        "command",
        "data"
      ],
      "type": "object"
    }
  ]
}
