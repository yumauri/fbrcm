{
  "$defs": {
    "path_segment": {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/path_segment"
    },
    "stateless_target_selector": {
      "pattern": "^(?:(?:[cC][lL][iI][eE][nN][tT]|[sS][eE][rR][vV][eE][rR])@)?[^=^/~@\\s][^@\\s]*$",
      "type": "string",
      "x-fbrcm-grammar": "[client@|server@]literal physical project ID; an omitted template prefix selects client",
      "x-fbrcm-matching": [
        {
          "comparison": "exact_case_sensitive",
          "default_template": "client",
          "lookup": false,
          "operator": "literal_project_id"
        }
      ]
    },
    "target_positional_selector": {
      "allOf": [
        {
          "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/target_positional_selector"
        }
      ],
      "x-fbrcm-normalization": [
        {
          "operator": "canonicalize_positional_target_selector",
          "source": "argv",
          "target": "normalized_invocation"
        }
      ]
    }
  },
  "$id": "urn:fbrcm:schema:cli:1.0.0:command:conditions.rename:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "options": {
          "if": {
            "properties": {
              "stateless": {
                "const": true
              }
            },
            "required": [
              "stateless"
            ]
          },
          "then": {
            "not": {
              "required": [
                "profile"
              ]
            },
            "properties": {
              "draft": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "options": {
            "properties": {
              "profile": {
                "allOf": [
                  {
                    "$ref": "#/$defs/path_segment"
                  }
                ]
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "options": {
            "properties": {
              "stateless": {
                "const": true
              }
            },
            "required": [
              "stateless"
            ]
          }
        },
        "required": [
          "options"
        ]
      },
      "then": {
        "properties": {
          "arguments": {
            "properties": {
              "project": {
                "$ref": "#/$defs/stateless_target_selector"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "options": {
          "not": {
            "required": [
              "plan-out",
              "draft"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "options": {
          "not": {
            "required": [
              "plan-out",
              "dry-run"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "options": {
          "not": {
            "required": [
              "plan-out",
              "yes"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "arguments": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string",
          "x-fbrcm-matching": [
            {
              "operator": "condition_positional_resolution"
            }
          ]
        },
        "new_name": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ]
        },
        "project": {
          "$ref": "#/$defs/target_positional_selector"
        }
      },
      "required": [
        "project",
        "condition",
        "new_name"
      ],
      "type": "object"
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "change-note": {
          "description": "Change note for publication or the stored draft",
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ],
          "x-fbrcm-validation": [
            {
              "allow_empty": true,
              "operator": "reject_raw_whitespace_only"
            }
          ]
        },
        "draft": {
          "description": "Save changes to a local draft instead of publishing; cannot be combined with --stateless",
          "type": "boolean",
          "x-fbrcm-effective-when": [
            {
              "all_of": [
                {
                  "source": "option",
                  "name": "stateless",
                  "operator": "equals",
                  "value": false
                }
              ]
            }
          ]
        },
        "dry-run": {
          "description": "Preview the requested mutation without applying it",
          "type": "boolean"
        },
        "no-local-config": {
          "description": "Ignore .fbrcm.toml repository configuration (env: FBRCM_NO_LOCAL_CONFIG)",
          "type": "boolean"
        },
        "plan-out": {
          "description": "Write an immutable validated publication plan instead of applying the mutation",
          "pattern": ".*\\S.*",
          "type": "string"
        },
        "profile": {
          "description": "Use profile for this invocation without changing the active profile (env: FBRCM_PROFILE); cannot be combined with --stateless",
          "pattern": ".*\\S.*",
          "type": "string",
          "x-fbrcm-effective-when": [
            {
              "all_of": [
                {
                  "source": "option",
                  "name": "stateless",
                  "operator": "equals",
                  "value": false
                }
              ]
            }
          ],
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ]
        },
        "stateless": {
          "description": "Run a supported command without profiles or application-managed local state (Firebase API token env: FBRCM_GOOGLE_ACCESS_TOKEN)",
          "type": "boolean"
        },
        "timeout": {
          "description": "Maximum duration for the complete command",
          "not": {
            "pattern": "^\\+?(?:0*\\.)\\d+ns$"
          },
          "pattern": "^\\+?(?:(?:0+(?:\\.0*)?|\\.0+)(?:ns|us|µs|μs|ms|s|m|h))*(?:(?:\\d*[1-9]\\d*(?:\\.\\d*)?|0*\\.\\d*[1-9]\\d*)(?:ns|us|µs|μs|ms|s|m|h))(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h))*$",
          "type": "string",
          "x-fbrcm-grammar": "go-duration",
          "x-fbrcm-validation": [
            {
              "operator": "parse_duration",
              "parser": "time.ParseDuration",
              "require_positive": true
            }
          ]
        },
        "yes": {
          "description": "Print diff and apply without confirmation",
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "stdin": {
      "type": "null"
    }
  },
  "required": [
    "arguments",
    "options",
    "stdin"
  ],
  "type": "object"
}
