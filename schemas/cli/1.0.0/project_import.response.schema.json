  "$id": "urn:fbrcm:schema:cli:1.0.0:command:project.import:response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:envelope"
    },
    {
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "success",
                  "partial_success"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/success_data"
              }
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "enum": [
                "success",
                "partial_success",
                "failure"
              ]
            }
          }
        },
        {
          "properties": {
            "warnings": {
              "items": {
                "properties": {
                  "code": {
