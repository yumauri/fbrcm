      "properties": {
        "command": {
          "const": "project.import"
        },
        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/success_data"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema": {
          "const": "urn:fbrcm:schema:cli:1.0.0:command:project.import:response"
        }
