      "properties": {
        "change-note": {
          "description": "Change note for publication or the stored draft",
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ],
          "x-fbrcm-validation": [
            {
              "allow_empty": true,
              "operator": "reject_raw_whitespace_only"
            }
          ]
        },
        "draft": {
          "description": "Save changes to a local draft instead of publishing",
          "type": "boolean"
        },
        "dry-run": {
          "description": "Preview the requested mutation without applying it",
          "type": "boolean"
        },
        "expr": {
          "$ref": "#/$defs/expression",
          "description": "Filter parameters by expr-lang expression",
          "pattern": ".*\\S.*",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ]
        },
        "filter": {
          "description": "Filter parameters by mode-prefixed query (^, /, ~, =); may be repeated",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/filter_query"
              }
            ],
            "x-fbrcm-matching": [
              {
                "comparison": "unicode_case_insensitive",
                "default_mode": "fuzzy",
                "fields": [
                  "parameter_key"
                ],
                "mode_prefixes": {
                  "/": "includes",
                  "=": "exact",
                  "^": "starts-with",
                  "~": "fuzzy"
                },
                "operator": "mode_prefixed_query",
                "query_normalization": "trim_unicode_whitespace"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        },
        "no-local-config": {
          "description": "Ignore .fbrcm.toml repository configuration (env: FBRCM_NO_LOCAL_CONFIG)",
          "type": "boolean"
        },
        "profile": {
          "allOf": [
            {
              "$ref": "#/$defs/path_segment"
            }
          ],
          "description": "Use profile for this invocation without changing the active profile (env: FBRCM_PROFILE)",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ]
        },
        "project": {
          "description": "Filter template targets by optional client@ or server@ project query; may be repeated",
          "items": {
            "$ref": "#/$defs/target_selector"
          },
          "minItems": 1,
          "type": "array"
        },
        "search": {
          "description": "Search parameters by name, description, values, and conditions",
          "pattern": ".*\\S.*",
          "type": "string",
          "x-fbrcm-matching": [
            {
              "combination": "or",
              "match": "substring",
              "normalized_fields": [
                "name",
                "description",
                "condition_names"
              ],
              "normalized_query": "lowercase_alphanumeric_words",
              "operator": "parameter_search",
              "raw_fields": [
                "default_value",
                "conditional_values",
                "condition_expressions"
              ],
              "raw_query": "collapse_unicode_whitespace"
            }
          ]
        },
        "stateless": {
          "const": false,
          "description": "Run a supported command without profiles or application-managed local state (Firebase API token env: FBRCM_GOOGLE_ACCESS_TOKEN); true is currently rejected by this command",
          "type": "boolean"
        },
        "timeout": {
          "description": "Maximum duration for the complete command",
          "not": {
            "pattern": "^\\+?(?:0*\\.)\\d+ns$"
          },
          "pattern": "^\\+?(?:(?:0+(?:\\.0*)?|\\.0+)(?:ns|us|µs|μs|ms|s|m|h))*(?:(?:\\d*[1-9]\\d*(?:\\.\\d*)?|0*\\.\\d*[1-9]\\d*)(?:ns|us|µs|μs|ms|s|m|h))(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h))*$",
          "type": "string",
          "x-fbrcm-grammar": "go-duration",
          "x-fbrcm-validation": [
            {
              "operator": "parse_duration",
              "parser": "time.ParseDuration",
              "require_positive": true
            }
          ]
        },
        "yes": {
          "description": "Print diff and delete without confirmation",
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "stdin": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/remote_config"
        }
      ]
    }
  },
  "required": [
    "arguments",
    "options",
    "stdin"
  ],
  "type": "object",
  "x-fbrcm-matching": [
    {
      "absent_source_behavior": "match_all",
      "across_source_combination": "and",
      "operator": "selection_composition",
      "repeated_source_combination": "or",
      "sources": [
        "options.project",
        "options.filter",
        "options.search",
        "options.expr",
        "arguments.parameter"
