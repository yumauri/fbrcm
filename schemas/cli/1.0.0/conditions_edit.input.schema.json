{
  "$defs": {
    "path_segment": {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/path_segment"
    },
    "target_positional_selector": {
      "allOf": [
        {
          "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/target_positional_selector"
        }
      ],
      "x-fbrcm-normalization": [
        {
          "operator": "canonicalize_positional_target_selector",
          "source": "argv",
          "target": "normalized_invocation"
        }
      ]
    }
  },
  "$id": "urn:fbrcm:schema:cli:1.0.0:command:conditions.edit:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "options": {
          "anyOf": [
            {
              "required": [
                "expression"
              ]
            },
            {
              "required": [
                "color"
              ]
            },
            {
              "properties": {
                "no-color": {
                  "const": true
                }
              },
              "required": [
                "no-color"
              ]
            }
          ]
        }
      }
    },
    {
      "properties": {
        "options": {
          "not": {
            "properties": {
              "no-color": {
                "const": true
              }
            },
            "required": [
              "color",
              "no-color"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "arguments": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string",
          "x-fbrcm-matching": [
            {
              "operator": "condition_positional_resolution"
            }
          ]
        },
        "project": {
          "$ref": "#/$defs/target_positional_selector"
        }
      },
      "required": [
        "project",
        "condition"
      ],
      "type": "object"
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "change-note": {
          "description": "Change note for publication or the stored draft",
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ],
          "x-fbrcm-validation": [
            {
              "allow_empty": true,
              "operator": "reject_raw_whitespace_only"
            }
          ]
        },
        "color": {
          "description": "New Firebase display color",
          "pattern": "^(?:[cC][oO][nN][dD][iI][tT][iI][oO][nN]_[dD][iI][sS][pP][lL][aA][yY]_[cC][oO][lL][oO][rR]_[uU][nN][sS][pP][eE][cC][iI][fF][iI][eE][dD]|[bB][lL][uU][eE]|[bB][rR][oO][wW][nN]|[cC][yY][aA][nN]|[dD][eE][eE][pP]_[oO][rR][aA][nN][gG][eE]|[gG][rR][eE][eE][nN]|[iI][nN][dD][iI][gG][oO]|[lL][iI][mM][eE]|[oO][rR][aA][nN][gG][eE]|[pP][iI][nN][kK]|[pP][uU][rR][pP][lL][eE]|[tT][eE][aA][lL])$",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            },
            {
              "operator": "uppercase",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ],
          "x-fbrcm-values": [
            "CONDITION_DISPLAY_COLOR_UNSPECIFIED",
            "BLUE",
            "BROWN",
            "CYAN",
            "DEEP_ORANGE",
            "GREEN",
            "INDIGO",
            "LIME",
            "ORANGE",
            "PINK",
            "PURPLE",
            "TEAL"
          ]
        },
        "draft": {
          "description": "Save changes to a local draft instead of publishing",
          "type": "boolean"
        },
        "dry-run": {
          "description": "Preview the requested mutation without applying it",
          "type": "boolean"
        },
        "expression": {
          "description": "New raw Firebase condition expression",
          "pattern": ".*\\S.*",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ],
          "x-fbrcm-validation": [
            {
              "grammar": "condition_expression",
              "operator": "remote_validate",
              "service": "firebase_remote_config"
            }
          ]
        },
        "no-color": {
          "description": "Remove the display color",
          "type": "boolean"
        },
        "no-local-config": {
          "description": "Ignore .fbrcm.toml repository configuration (env: FBRCM_NO_LOCAL_CONFIG)",
          "type": "boolean"
        },
        "profile": {
          "allOf": [
            {
              "$ref": "#/$defs/path_segment"
            }
          ],
          "description": "Use profile for this invocation without changing the active profile (env: FBRCM_PROFILE)",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ]
        },
        "stateless": {
          "const": false,
          "description": "Run a supported command without profiles or application-managed local state (Firebase API token env: FBRCM_GOOGLE_ACCESS_TOKEN); true is currently rejected by this command",
          "type": "boolean"
        },
        "timeout": {
          "description": "Maximum duration for the complete command",
          "not": {
            "pattern": "^\\+?(?:0*\\.)\\d+ns$"
          },
          "pattern": "^\\+?(?:(?:0+(?:\\.0*)?|\\.0+)(?:ns|us|µs|μs|ms|s|m|h))*(?:(?:\\d*[1-9]\\d*(?:\\.\\d*)?|0*\\.\\d*[1-9]\\d*)(?:ns|us|µs|μs|ms|s|m|h))(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h))*$",
          "type": "string",
          "x-fbrcm-grammar": "go-duration",
          "x-fbrcm-validation": [
            {
              "operator": "parse_duration",
              "parser": "time.ParseDuration",
              "require_positive": true
            }
          ]
        },
        "yes": {
          "description": "Print diff and apply without confirmation",
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "stdin": {
      "type": "null"
    }
  },
  "required": [
    "arguments",
    "options",
    "stdin"
  ],
  "type": "object"
}
