{
  "$id": "urn:fbrcm:schema:cli:1.0.0:command:capabilities:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "x-fbrcm-grammar": "exact executable command argv path components",
          "x-fbrcm-matching": [
            {
              "candidate_source": "executable_commands",
              "comparison": "exact_case_sensitive_argv_components",
              "non_executable_result": "command.not_executable",
              "omitted_result": "capability_index",
              "operator": "command_path_resolution",
              "reserved_root_token": "root",
              "unknown_result": "command.not_found"
            }
          ]
        }
      },
      "required": [],
      "type": "object"
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "no-local-config": {
          "description": "Ignore .fbrcm.toml repository configuration (env: FBRCM_NO_LOCAL_CONFIG)",
          "type": "boolean"
        },
        "profile": {
          "description": "Use profile for this invocation without changing the active profile (env: FBRCM_PROFILE); accepted but not applied by this command",
          "pattern": ".*\\S.*",
          "type": "string",
          "x-fbrcm-effective": false
        },
        "timeout": {
          "description": "Maximum duration for the complete command",
          "not": {
            "pattern": "^\\+?(?:0*\\.)\\d+ns$"
          },
          "pattern": "^\\+?(?:(?:0+(?:\\.0*)?|\\.0+)(?:ns|us|µs|μs|ms|s|m|h))*(?:(?:\\d*[1-9]\\d*(?:\\.\\d*)?|0*\\.\\d*[1-9]\\d*)(?:ns|us|µs|μs|ms|s|m|h))(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h))*$",
          "type": "string",
          "x-fbrcm-grammar": "go-duration",
          "x-fbrcm-validation": [
            {
              "operator": "parse_duration",
              "parser": "time.ParseDuration",
              "require_positive": true
            }
          ]
        }
      },
      "required": [],
      "type": "object"
    },
    "stdin": {
      "type": "null"
    }
  },
  "required": [
    "arguments",
    "options",
    "stdin"
  ],
  "type": "object"
}
