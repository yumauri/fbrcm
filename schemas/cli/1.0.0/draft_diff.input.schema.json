{
  "$defs": {
    "draft_selector": {
      "allOf": [
        {
          "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/draft_selector"
        }
      ],
      "x-fbrcm-normalization": [
        {
          "operator": "canonicalize_positional_target_selector",
          "source": "argv",
          "target": "normalized_invocation"
        }
      ]
    },
    "expression": {
      "allOf": [
        {
          "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/expression"
        }
      ],
      "x-fbrcm-expression-context": "parameter"
    },
    "filter_query": {
      "allOf": [
        {
          "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/filter_query"
        }
      ],
      "x-fbrcm-normalization": [
        {
          "operator": "trim_unicode_whitespace",
          "source": "argv",
          "target": "normalized_invocation"
        }
      ]
    },
    "path_segment": {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/path_segment"
    }
  },
  "$id": "urn:fbrcm:schema:cli:1.0.0:command:draft.diff:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "options": {
          "not": {
            "required": [
              "parameters",
              "conditions"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "options": {
          "if": {
            "properties": {
              "cached": {
                "const": true
              }
            },
            "required": [
              "cached"
            ]
          },
          "then": {
            "properties": {
              "against": {
                "const": "current"
              }
            },
            "required": [
              "against"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "arguments": {
      "additionalProperties": false,
      "properties": {
        "project": {
          "$ref": "#/$defs/draft_selector"
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "against": {
          "description": "Comparison target: base or current",
          "enum": [
            "base",
            "current"
          ],
          "pattern": ".*\\S.*",
          "type": "string"
        },
        "cached": {
          "description": "Use the latest local snapshot and do not contact Firebase",
          "type": "boolean"
        },
        "conditions": {
          "description": "Include only condition changes",
          "type": "boolean"
        },
        "expr": {
          "$ref": "#/$defs/expression",
          "description": "Filter parameter changes by expr-lang expression",
          "pattern": ".*\\S.*",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ]
        },
        "filter": {
          "description": "Filter parameters by mode-prefixed query (^, /, ~, =); may be repeated",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/filter_query"
              }
            ],
            "x-fbrcm-matching": [
              {
                "comparison": "unicode_case_insensitive",
                "default_mode": "fuzzy",
                "fields": [
                  "parameter_key"
                ],
                "mode_prefixes": {
                  "/": "includes",
                  "=": "exact",
                  "^": "starts-with",
                  "~": "fuzzy"
                },
                "operator": "mode_prefixed_query",
                "query_normalization": "trim_unicode_whitespace"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        },
        "group": {
          "description": "Select parameters in group; may be repeated",
          "items": {
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "no-local-config": {
          "description": "Ignore .fbrcm.toml repository configuration (env: FBRCM_NO_LOCAL_CONFIG)",
          "type": "boolean"
        },
        "parameters": {
          "description": "Include only parameter and group description changes",
          "type": "boolean"
        },
        "profile": {
          "allOf": [
            {
              "$ref": "#/$defs/path_segment"
            }
          ],
          "description": "Use profile for this invocation without changing the active profile (env: FBRCM_PROFILE)",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ]
        },
        "search": {
          "description": "Search parameters by name, description, values, and conditions",
          "pattern": ".*\\S.*",
          "type": "string",
          "x-fbrcm-matching": [
            {
              "combination": "or",
              "match": "substring",
              "normalized_fields": [
                "name",
                "description",
                "condition_names"
              ],
              "normalized_query": "lowercase_alphanumeric_words",
              "operator": "parameter_search",
              "raw_fields": [
                "default_value",
                "conditional_values",
                "condition_expressions"
              ],
              "raw_query": "collapse_unicode_whitespace"
            }
          ]
        },
        "stateless": {
          "const": false,
          "description": "Run a supported command without profiles or application-managed local state (Firebase API token env: FBRCM_GOOGLE_ACCESS_TOKEN); true is currently rejected by this command",
          "type": "boolean"
        },
        "timeout": {
          "description": "Maximum duration for the complete command",
          "not": {
            "pattern": "^\\+?(?:0*\\.)\\d+ns$"
          },
          "pattern": "^\\+?(?:(?:0+(?:\\.0*)?|\\.0+)(?:ns|us|µs|μs|ms|s|m|h))*(?:(?:\\d*[1-9]\\d*(?:\\.\\d*)?|0*\\.\\d*[1-9]\\d*)(?:ns|us|µs|μs|ms|s|m|h))(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h))*$",
          "type": "string",
          "x-fbrcm-grammar": "go-duration",
          "x-fbrcm-validation": [
            {
              "operator": "parse_duration",
              "parser": "time.ParseDuration",
              "require_positive": true
            }
          ]
        }
      },
      "required": [],
      "type": "object"
    },
    "stdin": {
      "type": "null"
    }
  },
  "required": [
    "arguments",
    "options",
    "stdin"
  ],
  "type": "object",
  "x-fbrcm-matching": [
    {
      "absent_source_behavior": "match_all",
      "across_source_combination": "and",
      "operator": "selection_composition",
      "repeated_source_combination": "or",
      "sources": [
        "options.filter",
        "options.search",
        "options.expr",
        "options.group"
      ],
      "target_defaults": []
    }
  ]
}
