{
  "$defs": {
    "credentials": {
      "additionalProperties": true,
      "properties": {
        "client_email": {
          "type": "string",
          "x-fbrcm-validation": [
            {
              "operator": "parse_email",
              "parser": "net/mail.ParseAddress",
              "require_exact": true
            }
          ]
        },
        "private_key": {
          "pattern": ".*\\S.*",
          "type": "string"
        },
        "project_id": {
          "pattern": ".*\\S.*",
          "type": "string"
        },
        "token_uri": {
          "type": "string",
          "x-fbrcm-validation": [
            {
              "normalization": "trim_unicode_whitespace",
              "operator": "parse_uri",
              "parser": "net/url.ParseRequestURI",
              "require_absolute": true
            }
          ]
        },
        "type": {
          "const": "service_account"
        }
      },
      "required": [
        "type",
        "project_id",
        "private_key",
        "client_email",
        "token_uri"
      ],
      "type": "object"
    },
    "path_segment": {
      "$ref": "urn:fbrcm:schema:cli:1.0.0:semantic#/$defs/path_segment"
    }
  },
  "$id": "urn:fbrcm:schema:cli:1.0.0:command:auth.add.service-account:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "additionalProperties": false,
      "properties": {
        "auth_id": {
          "$ref": "#/$defs/path_segment"
        }
      },
      "required": [
        "auth_id"
      ],
      "type": "object"
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "Import service account key from file path; if omitted, read stdin or open file picker",
          "pattern": ".*\\S.*",
          "type": "string"
        },
        "label": {
          "description": "Auth identity label",
          "pattern": "^(?:$|.*\\S.*)$",
          "type": "string"
        },
        "no-local-config": {
          "description": "Ignore .fbrcm.toml repository configuration (env: FBRCM_NO_LOCAL_CONFIG)",
          "type": "boolean"
        },
        "profile": {
          "allOf": [
            {
              "$ref": "#/$defs/path_segment"
            }
          ],
          "description": "Use profile for this invocation without changing the active profile (env: FBRCM_PROFILE)",
          "type": "string",
          "x-fbrcm-normalization": [
            {
              "operator": "trim_unicode_whitespace",
              "source": "argv",
              "target": "normalized_invocation"
            }
          ]
        },
        "quota-project": {
          "description": "Persist the Google Cloud quota project for this auth identity",
          "pattern": ".*\\S.*",
          "type": "string"
        },
        "stateless": {
          "const": false,
          "description": "Run a supported command without profiles or application-managed local state (Firebase API token env: FBRCM_GOOGLE_ACCESS_TOKEN); true is currently rejected by this command",
          "type": "boolean"
        },
        "timeout": {
          "description": "Maximum duration for the complete command",
          "not": {
            "pattern": "^\\+?(?:0*\\.)\\d+ns$"
          },
          "pattern": "^\\+?(?:(?:0+(?:\\.0*)?|\\.0+)(?:ns|us|µs|μs|ms|s|m|h))*(?:(?:\\d*[1-9]\\d*(?:\\.\\d*)?|0*\\.\\d*[1-9]\\d*)(?:ns|us|µs|μs|ms|s|m|h))(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h))*$",
          "type": "string",
          "x-fbrcm-grammar": "go-duration",
          "x-fbrcm-validation": [
            {
              "operator": "parse_duration",
              "parser": "time.ParseDuration",
              "require_positive": true
            }
          ]
        }
      },
      "required": [],
      "type": "object"
    },
    "stdin": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/credentials"
        }
      ]
    }
  },
  "required": [
    "arguments",
    "options",
    "stdin"
  ],
  "type": "object",
  "x-fbrcm-input-selection": [
    {
      "later_sources": "ignored_without_consumption",
      "on_missing": "interaction.required",
      "operator": "first_available",
      "sources": [
        "options.from",
        "stdin.document"
      ]
    }
  ]
}
