{
  "name": "conditions_edit_stateless_json",
  "command_id": "conditions.edit",
  "args": [
    "--stateless", "conditions", "edit", "${PROJECT_ID}", "fbrcm_e2e_stateless_condition",
    "--expression", "percent <= 2", "--color", "GREEN", "--yes", "--json"
  ],
  "expected_exit_code": 0,
  "expected_http": [
    {"method": "GET", "host": "firebaseremoteconfig.googleapis.com", "path": "/v1/projects/${PROJECT_ID}/remoteConfig:listVersions", "query": "pageSize=1", "status": 200},
    {"method": "GET", "host": "firebaseremoteconfig.googleapis.com", "path": "/v1/projects/${PROJECT_ID}/remoteConfig", "status": 200},
    {"method": "PUT", "host": "firebaseremoteconfig.googleapis.com", "path": "/v1/projects/${PROJECT_ID}/remoteConfig", "query": "validateOnly=true", "status": 200},
    {"method": "PUT", "host": "firebaseremoteconfig.googleapis.com", "path": "/v1/projects/${PROJECT_ID}/remoteConfig", "status": 200}
  ],
  "log_level": "warn",
  "expected_absent_state_paths": [
    {"root": "config", "path": "config.toml"},
    {"root": "cache", "path": "profiles/default/remote-config"},
    {"root": "cache", "path": "profiles/default/drafts"}
  ],
  "envs": {"FBRCM_GOOGLE_ACCESS_TOKEN": "${FBRCM_E2E_ACCESS_TOKEN}"},
  "json_output": true
}
