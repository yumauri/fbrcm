{
  "name": "apps_config_stateless_json",
  "command_id": "apps.config",
  "args": [
    "--stateless",
    "apps",
    "config",
    "1:123456789012:web:c3",
    "--json"
  ],
  "expected_exit_code": 0,
  "expected_http": [
    {
      "method": "GET",
      "host": "firebase.googleapis.com",
      "path": "/v1beta1/projects/123456789012:searchApps",
      "query": "pageSize=100&showDeleted=true",
      "status": 200
    },
    {
      "method": "GET",
      "host": "firebase.googleapis.com",
      "path": "/v1beta1/projects/${PROJECT_ID}/webApps/web-app/config",
      "status": 200
    }
  ],
  "http_replay_only": true,
  "expected_absent_state_paths": [
    {"root": "config", "path": "config.toml"},
    {"root": "cache", "path": "profiles/default/remote-config"}
  ],
  "json_output": true,
  "envs": {
    "FBRCM_GOOGLE_ACCESS_TOKEN": "${FBRCM_E2E_ACCESS_TOKEN}"
  }
}
