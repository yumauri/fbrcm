{
  "version": 1,
  "default_auth_id": "e2e",
  "auth": [
    {
      "id": "e2e",
      "type": "oauth",
      "label": "E2E fixture",
      "client_secret_path": "auth/e2e/client-secret.json",
      "token_path": "auth/e2e/token.json"
    },
    {
      "id": "google-secondary",
      "type": "google",
      "label": "Synthetic built-in Google identity",
      "token_path": "auth/google-secondary/token.json"
    }
  ]
}
