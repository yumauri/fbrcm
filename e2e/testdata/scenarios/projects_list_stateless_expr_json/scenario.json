{
  "name": "projects_list_stateless_expr_json",
  "command_id": "projects.list",
  "args": [
    "--stateless", "projects", "list",
    "--filter", "=Northstar Wallet",
    "--expr", "project_id == \"northstar-wallet\" && \"support_chat_enabled\" in keys(parameters)",
    "--json"
  ],
  "expected_exit_code": 0,
  "expected_http": [
    {"method": "GET", "host": "cloudresourcemanager.googleapis.com", "path": "/v1/projects", "query": "pageSize=1000", "status": 200},
    {"method": "GET", "host": "cloudresourcemanager.googleapis.com", "path": "/v3/projects/${PROJECT_ID}", "status": 200},
    {"method": "GET", "host": "cloudresourcemanager.googleapis.com", "path": "/v3/projects/mercato-mobile-9eac5", "status": 200},
    {"method": "GET", "host": "cloudresourcemanager.googleapis.com", "path": "/v3/projects/pulseforge-fitness-f60f7", "status": 200},
    {"method": "GET", "host": "cloudresourcemanager.googleapis.com", "path": "/v3/projects/signalops-console", "status": 200},
    {"method": "GET", "host": "cloudresourcemanager.googleapis.com", "path": "/v3/projects/streamline-play", "status": 200},
    {"method": "GET", "host": "firebaseremoteconfig.googleapis.com", "path": "/v1/projects/${PROJECT_ID}/remoteConfig:listVersions", "query": "pageSize=1", "status": 200},
    {"method": "GET", "host": "firebaseremoteconfig.googleapis.com", "path": "/v1/projects/${PROJECT_ID}/remoteConfig", "query": "versionNumber=12", "status": 200}
  ],
  "http_unordered": true,
  "log_level": "warn",
  "expected_absent_state_paths": [
    {"root": "config", "path": "config.toml"},
    {"root": "cache", "path": "profiles/default/remote-config"},
    {"root": "cache", "path": "profiles/default/drafts"}
  ],
  "envs": {"FBRCM_GOOGLE_ACCESS_TOKEN": "${FBRCM_E2E_ACCESS_TOKEN}"},
  "json_output": true
}
