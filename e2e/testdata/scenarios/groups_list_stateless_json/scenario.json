{
  "name": "groups_list_stateless_json",
  "command_id": "groups.list",
  "args": ["--stateless", "groups", "list", "--project", "=${PROJECT_ID}", "--filter", "=support", "--search", "maintenance", "--json"],
  "expected_exit_code": 0,
  "expected_http": [
    {"method": "GET", "host": "firebaseremoteconfig.googleapis.com", "path": "/v1/projects/${PROJECT_ID}/remoteConfig:listVersions", "query": "pageSize=1", "status": 200},
    {"method": "GET", "host": "firebaseremoteconfig.googleapis.com", "path": "/v1/projects/${PROJECT_ID}/remoteConfig", "status": 200}
  ],
  "expected_absent_state_paths": [
    {"root": "config", "path": "config.toml"},
    {"root": "cache", "path": "default/remote-config"},
    {"root": "cache", "path": "default/drafts"}
  ],
  "envs": {"FBRCM_GOOGLE_ACCESS_TOKEN": "${FBRCM_E2E_ACCESS_TOKEN}"},
  "json_output": true
}
