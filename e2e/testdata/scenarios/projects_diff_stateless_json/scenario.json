{
  "name": "projects_diff_stateless_json",
  "command_id": "projects.diff",
  "args": ["--stateless", "projects", "diff", "server@${PROJECT_ID}", "client@${PROJECT_ID}", "--json"],
  "expected_exit_code": 1,
  "expected_http": [
    {"method": "GET", "host": "firebaseremoteconfig.googleapis.com", "path": "/v1/projects/${PROJECT_ID}/namespaces/firebase-server/remoteConfig", "status": 200},
    {"method": "GET", "host": "firebaseremoteconfig.googleapis.com", "path": "/v1/projects/${PROJECT_ID}/remoteConfig", "status": 200}
  ],
  "expected_absent_state_paths": [
    {"root": "config", "path": "config.toml"},
    {"root": "cache", "path": "profiles/default/remote-config"},
    {"root": "cache", "path": "profiles/default/drafts"}
  ],
  "envs": {"FBRCM_GOOGLE_ACCESS_TOKEN": "${FBRCM_E2E_ACCESS_TOKEN}"},
  "json_output": true
}
