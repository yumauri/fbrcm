{
  "name": "apps_list_stateless_json",
  "command_id": "apps.list",
  "args": [
    "--stateless",
    "apps",
    "list",
    "${PROJECT_ID}",
    "--json"
  ],
  "expected_exit_code": 0,
  "expected_http": [
    {
      "method": "GET",
      "host": "firebase.googleapis.com",
      "path": "/v1beta1/projects/${PROJECT_ID}:searchApps",
      "query": "pageSize=100&showDeleted=true",
      "status": 200
    }
  ],
  "http_replay_only": true,
  "expected_absent_state_paths": [
    {"root": "config", "path": "config.toml"},
    {"root": "cache", "path": "profiles/default/remote-config"},
    {"root": "cache", "path": "profiles/default/apps"}
  ],
  "json_output": true,
  "envs": {
    "FBRCM_GOOGLE_ACCESS_TOKEN": "${FBRCM_E2E_ACCESS_TOKEN}"
  }
}
