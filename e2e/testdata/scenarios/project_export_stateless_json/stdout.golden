      "conditions": [
        {
          "name": "living_room_devices",
          "expression": "device.os == 'android' \u0026\u0026 percent \u003c= 40",
          "tagColor": "BLUE"
        },
        {
          "name": "sports_market_us",
          "expression": "device.country in ['us'] \u0026\u0026 percent \u003c= 35",
          "tagColor": "GREEN"
