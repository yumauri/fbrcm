{
  "name": "project_defaults_stateless_json",
  "command_id": "project.defaults",
  "args": [
    "--stateless",
    "project",
    "defaults",
    "${PROJECT_ID}",
    "--format",
    "json"
  ],
  "expected_exit_code": 0,
  "expected_http": [
    {
      "method": "GET",
      "host": "firebaseremoteconfig.googleapis.com",
      "path": "/v1/projects/${PROJECT_ID}/remoteConfig:downloadDefaults",
      "status": 200
    }
  ],
  "expected_absent_state_paths": [
    {"root": "config", "path": "config.toml"},
    {"root": "cache", "path": "default/remote-config"}
  ],
  "envs": {
    "FBRCM_GOOGLE_ACCESS_TOKEN": "${FBRCM_E2E_ACCESS_TOKEN}"
  }
}
